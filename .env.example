# Database — PostgreSQL (produção) ou SQLite (MVP local)
DATABASE_URL=postgresql+asyncpg://ebd_user:ebd_pass@db:5432/ebd

# Para desenvolvimento local sem Docker, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./ebd.db

# Desenvolvimento: uma igreja só. Em produção NÃO defina: a igreja vem do domínio (Host) e host desconhecido dá 404.
IGREJA_PADRAO_ID=1

# App
APP_NAME=Sistema EBD
DEBUG=true
SECRET_KEY=change-me-in-production

# Produção (docker-compose.prod.yml): senha do Postgres e senha do primeiro admin (opcional)
# POSTGRES_PASSWORD=troque-por-uma-senha-forte
# APP_DB_PASSWORD=outra-senha-forte-so-com-letras-numeros-e-_.~-   (papel ebd_app, usado pelo app; min. 16)
# DOMINIO_BASE=minhaebd.cloud   (subdominios das igrejas: igreja.minhaebd.cloud)
# ADMIN_INITIAL_PASSWORD=
