# Database — PostgreSQL (produção) ou SQLite (MVP local)
DATABASE_URL=postgresql+asyncpg://ebd_user:ebd_pass@db:5432/ebd

# Para desenvolvimento local sem Docker, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./ebd.db

# App
APP_NAME=Sistema EBD
DEBUG=true
SECRET_KEY=change-me-in-production

# Produção (docker-compose.prod.yml): senha do Postgres e senha do primeiro admin (opcional)
# POSTGRES_PASSWORD=troque-por-uma-senha-forte
# ADMIN_INITIAL_PASSWORD=
